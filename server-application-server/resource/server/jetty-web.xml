<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure.dtd">

<Configure class="org.eclipse.jetty.ee10.webapp.WebAppContext">
    <Call name="insertHandler">
        <Arg>
            <New id="GzipHandler" class="org.eclipse.jetty.server.handler.gzip.GzipHandler">
                <!-- size in bytes; maps to setMinGzipSize(int) -->
                <Set name="minGzipSize"><Property name="jetty.gzip.minGzipSize" default="2048"/></Set>

                <!-- request inflation buffer; maps to setInflateBufferSize(int) -->
                <Set name="inflateBufferSize"><Property name="jetty.gzip.inflateBufferSize" default="0"/></Set>

                <!-- flush mode; maps to setSyncFlush(boolean) -->
                <Set name="syncFlush"><Property name="jetty.gzip.syncFlush" default="false"/></Set>

                <!-- CSV lists; map to setIncludedMethodList/setExcludedMethodList -->
                <Set name="includedMethodList"><Property name="jetty.gzip.includedMethodList" default=""/></Set>
                <Set name="excludedMethodList"><Property name="jetty.gzip.excludedMethodList" default=""/></Set>
            </New>
        </Arg>
    </Call>
    <Call class="java.lang.System" name="setProperty">
        <Arg>org.eclipse.jetty.util.UrlEncoded.allowEncodedSlash</Arg>
        <Arg>true</Arg>
    </Call>
    <!-- allow legacy path -->
    <Call class="java.lang.System" name="setProperty">
        <Arg>org.eclipse.jetty.http.UriCompliance</Arg>
        <Arg>UNSAFE</Arg>
    </Call>
</Configure>
