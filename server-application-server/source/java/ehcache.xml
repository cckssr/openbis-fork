<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3 https://www.ehcache.org/schema/ehcache-core-3.0.xsd">

    <!-- Hibernate query + timestamps regions -->
    <cache alias="hibernateQueryResultsRegion">
        <key-type>java.lang.Object</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry><none/></expiry> <!-- eternal -->
        <resources>
            <heap unit="entries">1000000</heap>
        </resources>
    </cache>

    <cache alias="hibernateTimestampsRegion">
        <key-type>java.lang.Object</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry><none/></expiry>
        <resources>
            <heap unit="entries">1000000</heap>
        </resources>
    </cache>

    <!-- App caches -->

    <cache alias="searchCache">
        <key-type>ch.ethz.sis.openbis.generic.server.asapi.v3.cache.SearchCacheKey</key-type>
        <value-type>ch.systemsx.cisd.openbis.generic.shared.util.RuntimeCache$ValueWrapper</value-type>
        <!-- timeToIdleSeconds = 3600, no absolute TTL -->
        <expiry>
            <tti unit="seconds">3600</tti>
        </expiry>
        <resources>
            <heap unit="entries">500000</heap>
        </resources>
    </cache>

    <cache alias="tableDataCache">
        <key-type>java.lang.Object</key-type>
        <value-type>ch.systemsx.cisd.openbis.generic.shared.util.RuntimeCache$ValueWrapper</value-type>
        <expiry>
            <tti unit="seconds">3600</tti>
        </expiry>
        <resources>
            <heap unit="entries">500000</heap>
        </resources>
    </cache>

</config>
