<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE Configure PUBLIC "-//Eclipse Foundation//DTD Configure//EN"
        "http://www.eclipse.org/jetty/configure.dtd">

<Configure id="ctx" class="org.eclipse.jetty.ee10.webapp.WebAppContext">

    <Call name="addAliasCheck">
        <Arg>
            <New class="org.eclipse.jetty.server.SymlinkAllowedResourceAliasChecker">
                <Arg><Ref refid="ctx"/></Arg>
            </New>
        </Arg>
    </Call>

    <!-- Session cookie security -->
    <Get name="sessionHandler">
        <Get name="sessionCookieConfig">
            <Set name="httpOnly" type="boolean">true</Set>
        </Get>
    </Get>

</Configure>
