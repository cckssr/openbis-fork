<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd">
	<!-- Every suppression below carries an "until" review date so none of them
	     becomes a permanent blind spot. When a date lapses the finding
	     re-surfaces and breaks the build, forcing a conscious re-decision.
	     Three review tiers are used:

	       2026-09-01Z  near-term deferred upgrades - a fixed version is
	                    expected soon and we just need to pick it up.
	       2026-12-01Z  frozen / bundled artifacts and breaking upgrades -
	                    re-check at year end whether upstream has moved or the
	                    "kept as-is" policy still holds.
	       2027-06-01Z  CPE / version false positives - no upgrade can fix a
	                    mis-match, so these only need an annual re-validation
	                    that the matcher is still wrong. -->

	<!-- [2026-12-01] commons-compress shaded inside izpack-commons-compress-5.0-beta9
	     (used by app-openbis-installer). The izpack repackage cannot be upgraded;
	     the jython27 copy of commons-compress is handled by the jython wildcard
	     below. Re-check at year end together with the izpack block. -->
	<suppress until="2026-12-01Z">
		<packageUrl regex="true">^pkg:maven/org\.apache\.commons/commons\-compress@.*$</packageUrl>
		<cve>CVE-2021-35517</cve>
		<cve>CVE-2021-36090</cve>
	</suppress>
	<!-- [2027-06-01] httpclient 4.3.6 / 4.5.6 on production classpaths;
	     CVE-2020-13956 is a URL parsing issue that does not affect how openBIS
	     constructs request URIs. False positive for our usage - annual re-check. -->
	<suppress until="2027-06-01Z">
		<packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents/httpclient@.*$</packageUrl>
		<cve>CVE-2020-13956</cve>
	</suppress>
	<!-- [2027-06-01] okhttp 3.11.0 (CVE-2018-20200 only affects callers that put
	     credentials in URLs, which openBIS does not do). Not-affected - annual re-check. -->
	<suppress until="2027-06-01Z">
		<packageUrl regex="true">^pkg:maven/com\.squareup\.okhttp3/okhttp@.*$</packageUrl>
		<cve>CVE-2018-20200</cve>
	</suppress>
	<!-- [2027-06-01] guava 18.0 / 20.0 / 31.1 on production classpaths. CVE-2020-8908
	     and CVE-2023-2976 are the same world-readable temp-dir family in
	     com.google.common.io (Files.createTempDir / FileBackedOutputStream);
	     CVE-2023-2976 is the follow-up "complete fix" CVE for CVE-2020-8908.
	     openBIS does not use these temp-dir APIs, and the legacy 18.0/20.0 jars
	     come from the openbis-ivy repo where a force-upgrade to 32+ would be a
	     14-major-version jump on old modules. Re-validate annually - a future
	     guava bump on the modern jars would also clear it. -->
	<suppress until="2027-06-01Z">
		<packageUrl regex="true">^pkg:maven/com\.google\.guava/guava@.*$</packageUrl>
		<cve>CVE-2020-8908</cve>
		<cve>CVE-2023-2976</cve>
	</suppress>
	<!-- [2027-06-01] qui-directory-tree is a tiny mvnpm-packaged JavaScript module;
	     OWASP's CPE heuristic incorrectly matches it against the Quarkus framework
	     (cpe:quarkus:quarkus) because of the "qu" prefix in the artifact id.
	     None of the matched CVEs apply to this artifact. Annual re-check. -->
	<suppress until="2027-06-01Z">
		<packageUrl regex="true">^pkg:maven/org\.mvnpm\.at\.qomponent/qui-directory-tree@.*$</packageUrl>
		<cpe>cpe:/a:quarkus:quarkus</cpe>
	</suppress>
	<!-- [2026-12-01] bioformats 6.5.2 is kept as-is per project policy; the shaded jars
	     (jackson-databind 2.9.6, logback 1.1.1, guava 27.1, okhttp 3.7,
	     okio 1.12, commons-lang 2.4, org.openmicroscopy:* libs) cannot be
	     upgraded without rebuilding bioformats. Re-check at year end whether the
	     "kept as-is" policy still holds or a newer bioformats can be adopted. -->
	<suppress until="2026-12-01Z">
		<notes><![CDATA[ shaded inside bioformats-6.5.2.jar -- kept as-is per project policy ]]></notes>
		<filePath regex="true">.*bioformats-6\.5\.2\.jar.*</filePath>
		<vulnerabilityName regex="true">.*</vulnerabilityName>
	</suppress>
	<!-- [2026-12-01] jython 2.5 and 2.7 ship as fat jars with old jline / guava /
	     commons-compress shaded inside. openBIS uses them as embedded
	     scripting interpreters; the shaded transitives cannot be upgraded
	     without rebuilding jython. Re-check at year end for a newer jython. -->
	<suppress until="2026-12-01Z">
		<notes><![CDATA[ shaded inside jython-2.5.2.jar / jython27-2.7.2.jar -- embedded scripting interpreter, unrebuildable here ]]></notes>
		<filePath regex="true">.*jython(27)?-2\.[57]\.2\.jar.*</filePath>
		<vulnerabilityName regex="true">.*</vulnerabilityName>
	</suppress>
	<!-- [2027-06-01] CVE-2020-29582 affects Kotlin <= 1.4.20 (the createTempDir/File
	     issue was fixed in 1.4.21). The reported artifacts are at 1.8.10,
	     which is past the fix, so this is an OWASP CPE-matcher false
	     positive (its version-range data has no upper bound). Annual re-check. -->
	<suppress until="2027-06-01Z">
		<packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-(stdlib|stdlib-common|reflect)@.*$</packageUrl>
		<cve>CVE-2020-29582</cve>
	</suppress>
	<!-- [2026-12-01] netty is unified across the whole build on a single
	     4.1.134.Final (the io-netty-netty-all catalog alias, used by lib-http,
	     server-data-store and server-sftp). We deliberately stay on the 4.1.x
	     line rather than 4.2.x because Quarkus 3.36.0 / Vert.x 4.5.27 (the
	     server-ro-crate stack) are built against netty 4.1 (the Quarkus BOM pins
	     4.1.133.Final); pulling netty 4.2.x onto that classpath breaks request
	     handling (the RO-Crate server dropped connections with EOF on
	     validate/import). 4.1.134 is the latest 4.1.x, so there is no patched
	     4.1 to move to yet, and the CVE-2026-42582 fix in the 4.2.x line cannot
	     be adopted until Quarkus/Vert.x support netty 4.2. Re-check at year end
	     whether a patched 4.1.x has shipped or Quarkus has moved to netty 4.2 so
	     the whole build can upgrade together. -->
	<suppress until="2026-12-01Z">
		<packageUrl regex="true">^pkg:maven/io\.netty/netty-.*@4\.1\.134\.Final$</packageUrl>
		<cve>CVE-2026-42582</cve>
	</suppress>
	<!-- [2026-12-01] IzPack 5.0-beta9 is the installer-build toolkit, pulled in ONLY by
	     app-openbis-installer. It is a frozen, repackaged beta snapshot whose
	     shaded jars bundle very old libraries (xstream 1.3.1, ant 1.8.2,
	     commons-compress 1.1) that cannot be upgraded without replacing IzPack
	     itself. These never run on the deployed openBIS server; they execute
	     only while building/running the installer, so the bundled CVEs are
	     not exploitable in the product. Re-check at year end for an IzPack
	     replacement / newer release. -->
	<suppress until="2026-12-01Z">
		<notes><![CDATA[ izpack installer toolkit (app-openbis-installer only) -- frozen beta9 repackage, unupgradable, not on any server classpath ]]></notes>
		<filePath regex="true">.*izpack-(xstream|ant|commons-compress)-5\.0-beta9.*\.jar.*</filePath>
		<vulnerabilityName regex="true">.*</vulnerabilityName>
	</suppress>
	<!-- [2026-12-01] h2 1.1.115 ships on the server classpath only as the alternative
	     DatabaseEngine.H2 option; every production service.properties uses
	     database.engine=postgresql, and H2 (when used at all) runs embedded
	     (jdbc:h2:file:...;DB_CLOSE_DELAY=-1). The H2 web Console / TCP Server
	     are never started (no org.h2.tools.Console/Server usage anywhere), so
	     the Console/CLI JNDI-RCE vectors below are not reachable. The 1.1.115
	     -> 2.x upgrade that fixes these is a breaking file-format + SQL-dialect
	     change with no 1.x patch escape; re-assess at year end alongside any
	     planned H2 2.x migration. -->
	<suppress until="2026-12-01Z">
		<packageUrl regex="true">^pkg:maven/com\.h2database/h2@1\.1\.115$</packageUrl>
		<cve>CVE-2021-42392</cve>
		<cve>CVE-2022-23221</cve>
		<cve>CVE-2022-45868</cve>
	</suppress>
	<!-- [2026-09-01] libthrift 0.22.0 is transitive via the RO-Crate / RDF stack
	     (jena-arq 5.6.0 -> lib-ro-crate -> server-ro-crate). The Java-relevant
	     fixes ship in Apache Thrift 0.23.0, but the build resolves only from the
	     curated openbis-ivy mirror (mavenCentral is disabled) and that mirror
	     currently carries only 0.19.0 / 0.22.0. Most of these CVEs are in the
	     c_glib (C) and Go bindings and match the Java jar only through the shared
	     cpe:apache:thrift. Suppress until 2026-09-01, by which point 0.23.0 should
	     be added to the mirror and force-pinned in build/common-resolutions.gradle;
	     if it lapses the findings re-surface so we revisit. -->
	<suppress until="2026-09-01Z">
		<notes><![CDATA[ libthrift 0.22.0 -- pending 0.23.0 in openbis-ivy mirror; mostly c_glib/Go CPE over-matches ]]></notes>
		<packageUrl regex="true">^pkg:maven/org\.apache\.thrift/libthrift@0\.22\.0$</packageUrl>
		<vulnerabilityName regex="true">.*</vulnerabilityName>
	</suppress>
	<!-- [2027-06-01] CVE-2025-7962 is a Jakarta Mail SMTP-injection issue (CR/LF in
	     message headers). OWASP's CPE matcher wrongly pins it to
	     jakarta.authentication-api (the Jakarta Authentication / JASPIC spec
	     bundled in jetty-home's ee9-jaspi lib), which is an unrelated artifact with
	     no SMTP/mail code. False positive - annual re-check. -->
	<suppress until="2027-06-01Z">
		<packageUrl regex="true">^pkg:maven/jakarta\.authentication/jakarta\.authentication-api@.*$</packageUrl>
		<cve>CVE-2025-7962</cve>
	</suppress>
</suppressions>
